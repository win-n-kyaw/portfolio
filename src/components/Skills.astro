---
interface Skill {
  _id: string;
  name: string;
  category: string;
  proficiency: number;
}

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

// Group by category
const grouped = skills.reduce(
  (acc, skill) => {
    if (!acc[skill.category]) acc[skill.category] = [];
    acc[skill.category].push(skill);
    return acc;
  },
  {} as Record<string, Skill[]>
);

const categoryIcons: Record<string, string> = {
  'Cloud Platforms': 'M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z',
  'Containers & Orchestration': 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2',
  'Infrastructure as Code': 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  Languages: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  Networking: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
  'AI & ML': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  Other: 'M13 10V3L4 14h7v7l9-11h-7z',
};
---

<section id="skills" class="section-padding bg-gray-50 dark:bg-gray-900/50">
  <div class="section-container">
    <h2 class="section-title">Skills & Tech Stack</h2>
    <div class="h-1 w-16 bg-primary-500 rounded mb-12"></div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {Object.entries(grouped).map(([category, items]) => (
        <div class="card">
          <div class="flex items-center gap-3 mb-5">
            <div class="p-2 rounded-lg bg-primary-100 dark:bg-primary-900/30">
              <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={categoryIcons[category] || categoryIcons.Other} />
              </svg>
            </div>
            <h3 class="font-semibold text-lg">{category}</h3>
          </div>
          <div class="space-y-3">
            {items.map((skill) => (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="font-medium">{skill.name}</span>
                  <span class="text-gray-500 dark:text-gray-500">{skill.proficiency}%</span>
                </div>
                <div class="h-2 bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-gradient-to-r from-primary-500 to-purple-500 rounded-full transition-all duration-1000"
                    style={`width: ${skill.proficiency}%`}
                  />
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
