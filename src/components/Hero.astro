---
interface Resume {
  label: string;
  url: string;
}

interface Props {
  name: string;
  role: string;
  tagline: string;
  email: string;
  github?: string;
  linkedin?: string;
  resumes?: Resume[];
}

const { name, role, tagline, email, github, linkedin, resumes = [] } = Astro.props;
---

<section id="hero" class="min-h-screen flex items-center section-container pt-16">
  <div class="w-full max-w-3xl">
    <p class="text-primary-500 font-mono text-sm mb-4 animate-fade-in-up">Hi, my name is</p>
    <h1 class="text-5xl md:text-7xl font-bold mb-4 animate-fade-in-up animate-delay-100">
      {name}<span class="gradient-text">.</span>
    </h1>
    <h2 class="text-3xl md:text-5xl font-bold text-gray-500 dark:text-gray-400 mb-6 animate-fade-in-up animate-delay-200">
      {role}
    </h2>
    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-xl mb-10 animate-fade-in-up animate-delay-300">
      {tagline}
    </p>
    <div class="flex flex-wrap gap-4 animate-fade-in-up animate-delay-400">
      <a href="#contact" class="btn-primary">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Get in Touch
      </a>

      <div class="relative" id="resume-dropdown">
        <button id="resume-btn" class="btn-outline" disabled={resumes.length === 0}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume
          {resumes.length > 0 && (
            <svg class="w-4 h-4 ml-1 transition-transform duration-200" id="resume-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          )}
        </button>
        {resumes.length > 0 && (
          <div id="resume-menu" class="absolute left-0 mt-2 w-56 rounded-lg bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black/5 dark:ring-white/10 py-1 opacity-0 invisible translate-y-1 transition-all duration-200 z-50">
            {resumes.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                download
                class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
              >
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                {r.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="flex items-center gap-3 ml-2">
        {github && (
          <a href={github} target="_blank" rel="noopener" class="text-gray-500 hover:text-primary-500 transition-colors" aria-label="GitHub">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          </a>
        )}
        {linkedin && (
          <a href={linkedin} target="_blank" rel="noopener" class="text-gray-500 hover:text-primary-500 transition-colors" aria-label="LinkedIn">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('resume-btn');
  const menu = document.getElementById('resume-menu');
  const chevron = document.getElementById('resume-chevron');
  let open = false;

  function toggle() {
    open = !open;
    if (open) {
      menu?.classList.remove('opacity-0', 'invisible', 'translate-y-1');
      menu?.classList.add('opacity-100', 'visible', 'translate-y-0');
      chevron?.style.setProperty('transform', 'rotate(180deg)');
    } else {
      menu?.classList.add('opacity-0', 'invisible', 'translate-y-1');
      menu?.classList.remove('opacity-100', 'visible', 'translate-y-0');
      chevron?.style.setProperty('transform', 'rotate(0deg)');
    }
  }

  btn?.addEventListener('click', toggle);

  document.addEventListener('click', (e) => {
    if (open && !document.getElementById('resume-dropdown')?.contains(e.target as Node)) {
      toggle();
    }
  });
</script>
