---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Blog from '../components/Blog.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

import { sanityFetch, urlFor, fileUrl } from '../lib/sanity';
import {
  siteSettings as fallbackSettings,
  aboutData as fallbackAbout,
  experienceData as fallbackExperience,
  projectsData as fallbackProjects,
  skillsData as fallbackSkills,
  certificationsData as fallbackCerts,
  blogData as fallbackBlog,
} from '../data/fallback';

// Fetch from Sanity or fall back to local data
const settings =
  (await sanityFetch<any>(`*[_type == "siteSettings"][0]{ ..., "resumeCloudEngUrl": resumeCloudEng.asset->url, "resumeSTEMUrl": resumeSTEM.asset->url }`)) || fallbackSettings;

const aboutRaw = await sanityFetch<any>(`*[_type == "about"][0]`);
const about = aboutRaw || fallbackAbout;
const aboutImageUrl = aboutRaw?.image ? urlFor(aboutRaw.image).width(400).url() : (fallbackAbout.imageUrl || '');

const experiences =
  (await sanityFetch<typeof fallbackExperience>(
    `*[_type == "experience"] | order(startDate desc)`
  )) || fallbackExperience;

const projectsRaw =
  (await sanityFetch<any[]>(
    `*[_type == "project"] | order(order asc)`
  )) || fallbackProjects;

const projects = projectsRaw.map((p: any) => ({
  ...p,
  imageUrl: p.image ? urlFor(p.image).width(600).url() : (p.imageUrl || ''),
}));

const skills =
  (await sanityFetch<typeof fallbackSkills>(
    `*[_type == "skill"] | order(category asc, proficiency desc)`
  )) || fallbackSkills;

const blog =
  (await sanityFetch<typeof fallbackBlog>(
    `*[_type == "blogPost"] | order(publishedAt desc) { _id, title, "slug": slug.current, excerpt, publishedAt, tags }`
  )) || fallbackBlog;

const certifications = fallbackCerts;

// Fetch dedicated resume documents (preferred) with fallback to siteSettings file fields
const resumeDocs = await sanityFetch<any[]>(
  `*[_type == "resume"] | order(order asc) { label, "fileRef": file.asset->url }`
);

const resumes: { label: string; url: string }[] = resumeDocs?.length
  ? resumeDocs
      .filter((r: any) => r.label && r.fileRef)
      .map((r: any) => ({ label: r.label, url: r.fileRef }))
  : [
      settings.resumeCloudEngUrl && { label: 'Cloud Engineering', url: settings.resumeCloudEngUrl },
      settings.resumeSTEMUrl && { label: 'STEM Educator', url: settings.resumeSTEMUrl },
    ].filter(Boolean) as { label: string; url: string }[];
---

<Layout title={`${settings.title} — ${settings.role}`}>
  <Navbar />
  <main>
    <Hero
      name={settings.title}
      role={settings.role}
      tagline={settings.tagline}
      email={settings.email}
      github={settings.github}
      linkedin={settings.linkedin}
      resumes={resumes}
    />
    <About heading={about.heading} bio={about.bio} imageUrl={aboutImageUrl} />
    <Certifications certifications={certifications} />
    <Skills skills={skills} />
    <Experience experiences={experiences} />
    <Projects projects={projects} />
    <Blog posts={blog} />
    <Contact
      email={settings.email}
      phone={settings.phone}
      location={settings.location}
      linkedin={settings.linkedin}
      github={settings.github}
    />
  </main>
  <FloatingCTA />
  <Footer name={settings.title} />
</Layout>
